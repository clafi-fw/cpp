// The version resource of a ClaFi application. ClaFi.AppVersion.props states its values.

#include "winres.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION CLAFI_APP_VERSION_NUMBERS
 PRODUCTVERSION CLAFI_APP_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ClaFi Framework"
            VALUE "FileDescription", CLAFI_APP_NAME
            VALUE "FileVersion", CLAFI_APP_VERSION_TEXT
            VALUE "LegalCopyright", "Copyright (c) 2026 Oleg Zhukov"
            VALUE "ProductName", CLAFI_APP_NAME
            VALUE "ProductVersion", CLAFI_APP_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
